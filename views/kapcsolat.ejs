<%- include("partials/header", { title: "Kapcsolat" }) %>
<%
    // mezőnkénti hibajelzés (szerver oldali ellenőrzés eredménye)
    const invalid = (mezo) => (hibak[mezo] ? "is-invalid" : "");
%>
<section class="book_section layout_padding">
    <div class="container">
        <div class="heading_container">
            <h2>Kapcsolat</h2>
        </div>
        <div class="row">
            <div class="col-lg-7">
                <div class="form_container contact_form">
                    <form method="POST" action="/kapcsolat" novalidate>
                        <div class="form-group">
                            <label for="nev">Név *</label>
                            <input class="form-control <%= invalid("nev") %>" id="nev" name="nev" maxlength="100" value="<%= ertekek.nev %>" autocomplete="name">
                            <% if (hibak.nev) { %><div class="invalid-feedback"><%= hibak.nev %></div><% } %>
                        </div>
                        <div class="form-group">
                            <label for="email">E-mail cím *</label>
                            <input class="form-control <%= invalid("email") %>" type="email" id="email" name="email" maxlength="254" value="<%= ertekek.email %>" autocomplete="email">
                            <% if (hibak.email) { %><div class="invalid-feedback"><%= hibak.email %></div><% } %>
                        </div>
                        <div class="form-group">
                            <label for="targy">Tárgy</label>
                            <input class="form-control <%= invalid("targy") %>" id="targy" name="targy" maxlength="150" value="<%= ertekek.targy %>">
                            <% if (hibak.targy) { %><div class="invalid-feedback"><%= hibak.targy %></div><% } %>
                        </div>
                        <div class="form-group">
                            <label for="szoveg">Üzenet *</label>
                            <textarea class="form-control <%= invalid("szoveg") %>" id="szoveg" name="szoveg" rows="6" maxlength="2000"><%= ertekek.szoveg %></textarea>
                            <% if (hibak.szoveg) { %><div class="invalid-feedback"><%= hibak.szoveg %></div><% } %>
                        </div>
                        <p class="text-muted small">A *-gal jelölt mezők kitöltése kötelező. Az üzenet 10–2000 karakter lehet.</p>
                        <button type="submit">Küldés</button>
                    </form>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="contact_info">
                    <h4>Net pizzéria</h4>
                    <p><i class="fa fa-clock-o" aria-hidden="true"></i> Éjjel-nappal nyitva, minden nap 0–24 óráig</p>
                    <p><i class="fa fa-mobile" aria-hidden="true"></i> Rendelés SMS-ben: a pizza neve és a darabszám</p>
                    <p><i class="fa fa-envelope" aria-hidden="true"></i> Kérdését, véleményét ezen az űrlapon küldheti el nekünk.</p>
                    <% if (user) { %>
                        <p class="mb-0">Az elküldött üzeneteket az <a href="/uzenetek">Üzenetek</a> menüpontban olvashatja.</p>
                    <% } else { %>
                        <p class="mb-0">Az elküldött üzenetek a bejelentkezett felhasználók számára az Üzenetek menüpontban jelennek meg.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</section>
<%- include("partials/footer") %>
