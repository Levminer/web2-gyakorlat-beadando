<%- include("partials/header", { title: "Regisztráció" }) %>
<section class="book_section layout_padding">
    <div class="container">
        <div class="auth_box">
            <div class="heading_container">
                <h2>Regisztráció</h2>
            </div>
            <div class="form_container">
                <form method="POST">
                    <input class="form-control" name="username" placeholder="Felhasználónév (3–30 karakter)" minlength="3" maxlength="30" required>
                    <input class="form-control" type="password" name="password" placeholder="Jelszó (min. 6 karakter)" minlength="6" required>
                    <input class="form-control" type="password" name="password2" placeholder="Jelszó újra" minlength="6" required>
                    <button type="submit">Regisztráció</button>
                </form>
                <p class="mt-3">Van már fiókja? <a href="/login">Jelentkezzen be!</a></p>
            </div>
        </div>
    </div>
</section>
<%- include("partials/footer") %>
